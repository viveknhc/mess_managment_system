# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-real-envs
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (docker-compose overrides this with Postgres) ---
DATABASE_URL=sqlite:///db.sqlite3

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Email (expiry alerts). Leave EMAIL_HOST empty to print emails to the console ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MessDeck <noreply@localhost>
