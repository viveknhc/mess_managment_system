# Frontend env — copy to .env (Vite only exposes VITE_* vars to the browser).

# API base URL (defaults to /api/v1, proxied by Vite in dev)
VITE_API_BASE_URL=/api/v1

# Support contact shown on the landing page, billing page, suspended banner and Help & Support.
# Optional overrides: src/config/support.ts already defaults to these.
VITE_SUPPORT_WHATSAPP=918547768153
VITE_SUPPORT_EMAIL=viveknhc@gmail.com
